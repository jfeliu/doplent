# Copy to `.env` and export these (or set them in your process manager) for
# any deployment other than local dev. Defaults in config/settings.py are
# dev-only and unsuitable for production.

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Required whenever the site is served over HTTPS behind a proxy that isn't
# also in ALLOWED_HOSTS's scheme (e.g. Fly.io) - must include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Defaults to the local SQLite file if unset. Set to a Postgres connection
# string (e.g. from Supabase) for anything other than local dev.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (used to notify teachers of substitution offers). Defaults print to
# the console; set these for real delivery.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=notifications@example.com
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL="Doplent <notifications@example.com>"
DJANGO_EMAIL_TIMEOUT=10
